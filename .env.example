# YachaqMEDICAL Environment Configuration
# Copy this file to .env and fill in your values

# RunPod Serverless GPU Endpoint for MedGemma
# Get from: https://www.runpod.io/console/serverless
MEDGEMMA_API_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID

# RunPod API Key
# Get from: https://www.runpod.io/console/user/settings
MEDGEMMA_API_KEY=***

# Hugging Face Token (for model download on RunPod)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=***

# Optional: Agent Zero configuration
# AGENT_ZERO_PORT=80
# AGENT_ZERO_DATA_DIR=/a0/usr
